{
  "name": "hm2mqtt",
  "version": "3.4.4",
  "description": "Interface between Homematic CCU and MQTT",
  "type": "module",
  "main": "index.js",
  "preferGlobal": true,
  "bin": {
    "hm2mqtt": "index.js"
  },
  "files": [
    "index.js",
    "config.js",
    "lib/",
    "paramsets.json",
    "example-names.json",
    "names.schema.json",
    "scripts/"
  ],
  "engines": {
    "node": "^20.19 || ^22.12 || >=24"
  },
  "scripts": {
    "start": "node index.js",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "deploy": "bash deploy.sh",
    "test:e2e": "HM2MQTT_E2E=1 node --test --test-force-exit test/e2e.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hobbyquaker/hm2mqtt.js.git"
  },
  "keywords": [
    "mqtt",
    "smarthome",
    "mqtt-smarthome",
    "mqtt-interfaces",
    "home-automation",
    "home-assistant",
    "homematic",
    "homematic-ip",
    "ccu",
    "bidcos",
    "hmip",
    "eq-3"
  ],
  "author": "Sebastian Raff <hobbyquaker@gmail.com> (https://hobbyquaker.github.io)",
  "contributors": [
    "RF77 (https://github.com/RF77)",
    "Simon Christmann (https://github.com/dersimn)"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/hobbyquaker/hm2mqtt.js/issues"
  },
  "homepage": "https://github.com/hobbyquaker/hm2mqtt.js",
  "mqttInterfaces": {
    "spec": "2.0",
    "envPrefix": "HM2MQTT",
    "needs": [
      "network"
    ],
    "serviceExtra": []
  },
  "dependencies": {
    "binrpc": "^3.3.1",
    "homematic-rega": "^2.0.0",
    "homematic-xmlrpc": "^2.0.0",
    "mqtt-interfaces-core": "^0.15.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^16.0.0",
    "hm-simulator": "^0.1.1",
    "prettier": "^3.0.0"
  },
  "overrides": {
    "hm-simulator": {
      "homematic-xmlrpc": "^2.0.0"
    }
  }
}
