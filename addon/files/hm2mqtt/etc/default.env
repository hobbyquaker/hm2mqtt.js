# hm2mqtt addon configuration.
#
# These are the same HM2MQTT_* variables the systemd unit and the docker image use. The WebUI
# (Systemsteuerung -> hm2mqtt) writes this file, so editing it by hand is possible but never
# necessary. Every option and its variable name:
#
#   /usr/local/addons/hm2mqtt/bin/node /usr/local/addons/hm2mqtt/app/index.js --help
#
# This file is copied to etc/hm2mqtt.env on first install and is NOT overwritten by updates.

# first level of every topic
HM2MQTT_NAME=hm

# the CCU this addon runs on
HM2MQTT_CCU_ADDRESS=127.0.0.1
HM2MQTT_INTERFACES=auto

# the MQTT broker. Empty means "not configured yet" and the service refuses to start - set it in
# the WebUI, e.g. mqtt://192.168.1.10:1883. There is no broker on the CCU itself unless you
# install one (Mosquitto addon).
HM2MQTT_MQTT_URL=

# Home Assistant discovery is on by default; turn it off here if HA is not in use
#HM2MQTT_HA_DISCOVERY=false

# info | debug | trace
HM2MQTT_VERBOSITY=info
