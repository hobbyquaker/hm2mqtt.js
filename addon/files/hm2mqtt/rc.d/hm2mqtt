#!/bin/sh
#
# Service script for the hm2mqtt CCU addon. Called by run-parts at boot ("init" from
# S55InitAddons, "start" from S98StartAddons), at shutdown ("stop"), and by the WebUI
# ("info", "restart", "uninstall").

ADDON=hm2mqtt
ADDON_DIR=/usr/local/addons/hm2mqtt
CONF_DIR=/usr/local/etc/config
WWW_DIR=$CONF_DIR/addons/www/$ADDON

NODE=$ADDON_DIR/bin/node
APP=$ADDON_DIR/app/index.js
ENV_FILE=$ADDON_DIR/etc/hm2mqtt.env
# /var/run belongs to root. On openccu-lite's systemd products an addon may run confined, as its
# own user, and gets /run/addon-<name>/ from the unit's RuntimeDirectory - use that when it is
# there. On a CCU (and for an unconfined addon) nothing changes.
if [ -d /run/addon-$ADDON ]; then
    PIDFILE=/run/addon-$ADDON/$ADDON.pid
else
    PIDFILE=/var/run/$ADDON.pid
fi
LOG=$ADDON_DIR/var/hm2mqtt.log
LOG_MAX=1048576
# Task 17 (openccu-lite D-59): on openccu-lite everything logs to the journal and no addon writes a
# log file onto the SD card. hm2mqtt's output goes to journald under the unit's identifier, so
# `journalctl -u addon-hm2mqtt`, the settings page and the system's Log page find it.
JOURNAL_TAG=addon-$ADDON

[ -f $ADDON_DIR/versions ] && . $ADDON_DIR/versions

# ICU keeps its data outside the libraries; without this node does not start (musl build)
[ -n "$NODE_ICU_DATA" ] && export ICU_DATA="$NODE_ICU_DATA"

# openccu-lite: a LITE= line in /VERSION, or occulited - the rule RedMatic, the addon handbook and
# this addon's CGIs use. Read at every start, never remembered: the same /usr/local may move between
# a CCU and openccu-lite.
IsLite() {
    grep -q '^LITE=' /VERSION 2>/dev/null || [ -x /usr/bin/occulited ]
}

# Where hm2mqtt's output goes: "journal" on openccu-lite, the file everywhere else. It cannot simply
# be left to the unit: start-stop-daemon -b points the daemon's stdio at /dev/null. systemd-cat
# connects stdout and stderr to journald and execs node, so the recorded pid stays node's own.
# Without systemd-cat the file stays, rather than no log at all.
LogTarget() {
    if IsLite && command -v systemd-cat >/dev/null 2>&1; then
        echo journal
    else
        echo file
    fi
}

Running() {
    [ -f $PIDFILE ] || return 1
    kill -0 "$(cat $PIDFILE)" 2>/dev/null
}

Start() {
    if Running; then
        echo "$ADDON already running"
        return 0
    fi

    if [ ! -f $ENV_FILE ]; then
        logger -t $ADDON -p daemon.err "not configured - open Systemsteuerung -> hm2mqtt"
        echo "$ADDON is not configured yet"
        return 1
    fi

    # the config is a plain env file; the same HM2MQTT_* variables the systemd unit and the
    # docker image use
    set -a
    . $ENV_FILE
    set +a

    # The addon writes inside its own directory and nowhere else. Enforced here rather than left
    # to the config, because etc/hm2mqtt.env survives updates: an installation configured before
    # this existed would otherwise keep the old behaviour. HOME goes with it - hm2mqtt's state
    # directory falls back to $HOME/.hm2mqtt, and on a CCU that is /root on a read-only rootfs.
    export HOME="$ADDON_DIR"
    export HM2MQTT_STATE_DIR="$ADDON_DIR/var"
    export XDG_CACHE_HOME="$ADDON_DIR/var/cache"
    export XDG_CONFIG_HOME="$ADDON_DIR/etc"
    export TMPDIR="${TMPDIR:-/tmp}"

    if [ -z "$HM2MQTT_MQTT_URL" ]; then
        logger -t $ADDON -p daemon.err "no MQTT broker configured - open Systemsteuerung -> hm2mqtt"
        echo "$ADDON has no broker configured"
        return 1
    fi

    mkdir -p $ADDON_DIR/var $ADDON_DIR/var/cache
    if [ "$(LogTarget)" = journal ]; then
        # the file an earlier version wrote, or this /usr/local on a CCU: nothing writes it any more,
        # so it goes - once, since there is nothing left to remove at the next start
        if [ -e $LOG ] || [ -e $LOG.1 ]; then
            rm -f $LOG $LOG.1 2>/dev/null
            logger -t $ADDON -p daemon.info "openccu-lite: the log is the journal now (journalctl -u $JOURNAL_TAG); removed $LOG"
        fi
        RUN="exec systemd-cat -t $JOURNAL_TAG $NODE $APP"
    else
        if [ -f $LOG ] && [ "$(wc -c < $LOG)" -gt $LOG_MAX ]; then
            mv $LOG $LOG.1
        fi
        RUN="exec $NODE $APP >>$LOG 2>&1"
    fi

    echo -n "Starting $ADDON: "
    logger -t $ADDON -p daemon.info "starting hm2mqtt $VERSION_ADDON (node $NODE_VERSION)"
    # sh -c "exec ..." so the recorded pid is node's own, not a wrapper's (systemd-cat execs too)
    start-stop-daemon -S -b -m -p $PIDFILE -x /bin/sh -- -c "$RUN"
    echo "OK"
}

Stop() {
    if ! Running; then
        rm -f $PIDFILE
        echo "$ADDON not running"
        return 1
    fi
    echo -n "Stopping $ADDON: "
    logger -t $ADDON -p daemon.info "stopping hm2mqtt"
    start-stop-daemon -K -q -p $PIDFILE
    i=0
    while Running && [ $i -lt 10 ]; do
        sleep 1
        i=$((i + 1))
    done
    if Running; then
        logger -t $ADDON -p daemon.warn "killing hm2mqtt"
        kill -9 "$(cat $PIDFILE)" 2>/dev/null
    fi
    rm -f $PIDFILE
    echo "OK"
}

case "$1" in
    init)
        # called before the CCU interfaces are up - nothing to prepare, start happens later
        exit 0
        ;;

    start)
        Start
        ;;

    stop)
        Stop
        ;;

    restart)
        Stop
        sleep 2
        Start
        ;;

    info)
        echo "Info: <div>Homematic to MQTT bridge - <a target=\"_blank\" href=\"https://github.com/hobbyquaker/hm2mqtt.js\">github.com/hobbyquaker/hm2mqtt.js</a></div>"
        echo "Name: hm2mqtt"
        echo "Version: $VERSION_ADDON"
        echo "Update: /addons/hm2mqtt/update_check.cgi"
        echo "Config-Url: /addons/hm2mqtt/settings.cgi"
        echo "Operations: restart uninstall"
        ;;

    uninstall)
        Stop
        $ADDON_DIR/bin/update_addon $ADDON
        if [ -f /usr/local/etc/monit-hm2mqtt.cfg ]; then
            rm -f /usr/local/etc/monit-hm2mqtt.cfg
            [ -x /usr/bin/monit ] && /usr/bin/monit reload >/dev/null 2>&1
        fi
        rm -f $CONF_DIR/rc.d/$ADDON
        rm -rf $WWW_DIR
        rm -rf $ADDON_DIR
        logger -t $ADDON -p daemon.info "uninstalled hm2mqtt"
        ;;

    *)
        echo "Usage: $ADDON {init|start|stop|restart|info|uninstall}" >&2
        exit 1
        ;;
esac

exit 0
